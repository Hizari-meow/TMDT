# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# PostgreSQL 16 Configuration
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale_secret
POSTGRES_DB=flashsale_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://flashsale:flashsale_secret@localhost:5433/flashsale_db?schema=public

# Redis 7.2 Configuration (AOF Enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# Payment Webhook HMAC Verification Secret
WEBHOOK_SECRET=whsec_super_secret_hmac_sha256_key_998877

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_FLASH_SALE_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_DEFAULT_PRODUCT_ID=22222222-2222-2222-2222-222222222222
NEXT_PUBLIC_DEFAULT_USER_ID=33333333-3333-3333-3333-333333333333
