datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders       Order[]
  customer     Customer?

  @@map("users")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products    Product[]

  @@map("categories")
}

model Product {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(255)
  description     String?          @db.Text
  price           Decimal          @db.Decimal(10, 2)
  stock           Int
  imageUrl        String?          @map("image_url") @db.VarChar(512)
  categoryId      String?          @map("category_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  flashSales      FlashSale[]
  orderItems      OrderItem[]
  inventoryStocks InventoryStock[]
  stockLedgers    StockLedger[]
  temporaryHolds  TemporaryHold[]

  @@map("products")
}

model FlashSale {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  flashPrice     Decimal   @map("flash_price") @db.Decimal(10, 2)
  allocatedStock Int       @map("allocated_stock")
  startTime      DateTime  @map("start_time") @db.Timestamptz(6)
  endTime        DateTime  @map("end_time") @db.Timestamptz(6)
  status         String    @default("ACTIVE") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("flash_sales")
}

model Order {
  id          String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackingId  String    @map("tracking_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  flashSaleId String?   @map("flash_sale_id") @db.Uuid
  orderType   String    @default("FLASH_SALE") @map("order_type") @db.VarChar(32)
  status      String    @default("PENDING_PAYMENT") @db.VarChar(32)
  totalAmount Decimal   @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  flashSale  FlashSale?  @relation(fields: [flashSaleId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@id([id, createdAt])
  @@index([trackingId], map: "idx_orders_tracking_id")
  @@index([userId], map: "idx_orders_user_id")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  orderCreatedAt DateTime @map("order_created_at") @db.Timestamptz(6)
  productId      String   @map("product_id") @db.Uuid
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt], onDelete: Cascade)

  @@index([orderId], map: "idx_order_items_order_id")
  @@map("order_items")
}

model ProcessedPayment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @unique(map: "uq_processed_payments_txn") @map("transaction_id") @db.VarChar(128)
  orderId       String   @map("order_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @db.VarChar(32)
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_processed_payments_order_id")
  @@map("processed_payments")
}

model IdempotencyKey {
  key             String   @id @db.VarChar(128)
  orderId         String?  @map("order_id") @db.Uuid
  responsePayload Json?    @map("response_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model Warehouse {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(255)
  address         String           @db.Text
  manager         String           @db.VarChar(255)
  phone           String           @db.VarChar(50)
  status          String           @default("ACTIVE") @db.VarChar(32)
  capacity        Int              @default(10000)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  inventoryStocks InventoryStock[]
  stockLedgers    StockLedger[]
  temporaryHolds  TemporaryHold[]

  @@map("warehouses")
}

model InventoryStock {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  onHand      Int       @default(0) @map("on_hand")
  reserved    Int       @default(0)
  available   Int       @default(0)
  safetyStock Int       @default(10) @map("safety_stock")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId], map: "uq_product_warehouse")
  @@map("inventory_stocks")
}

model StockLedger {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  type          String    @db.VarChar(32)
  quantity      Int
  balanceBefore Int       @map("balance_before")
  balanceAfter  Int       @map("balance_after")
  referenceType String    @map("reference_type") @db.VarChar(32)
  referenceId   String?   @map("reference_id") @db.VarChar(255)
  note          String?   @db.Text
  performedBy   String    @default("System") @map("performed_by") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_stock_ledger_product")
  @@index([warehouseId], map: "idx_stock_ledger_warehouse")
  @@index([createdAt], map: "idx_stock_ledger_created_at")
  @@map("stock_ledger")
}

model TemporaryHold {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  quantity    Int
  status      String    @default("HELD") @db.VarChar(32)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_temporary_holds_order")
  @@index([expiresAt], map: "idx_temporary_holds_expires")
  @@map("temporary_holds")
}

model Shipment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  carrier             String    @db.VarChar(50)
  trackingCode        String    @unique @map("tracking_code") @db.VarChar(100)
  status              String    @default("CREATED") @db.VarChar(32)
  codAmount           Decimal   @default(0) @map("cod_amount") @db.Decimal(12, 2)
  shippingFee         Decimal   @default(30000) @map("shipping_fee") @db.Decimal(10, 2)
  recipientName       String    @map("recipient_name") @db.VarChar(255)
  recipientPhone      String    @map("recipient_phone") @db.VarChar(50)
  recipientAddress    String    @map("recipient_address") @db.Text
  weightGram          Int       @default(500) @map("weight_gram")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at") @db.Timestamptz(6)
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_shipments_order_id")
  @@index([status], map: "idx_shipments_status")
  @@map("shipments")
}

model CodReconciliation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchCode         String    @unique @map("batch_code") @db.VarChar(50)
  carrier           String    @db.VarChar(50)
  totalOrders       Int       @default(0) @map("total_orders")
  totalCodExpected  Decimal   @default(0) @map("total_cod_expected") @db.Decimal(14, 2)
  totalCodReceived  Decimal   @default(0) @map("total_cod_received") @db.Decimal(14, 2)
  discrepancyAmount Decimal   @default(0) @map("discrepancy_amount") @db.Decimal(14, 2)
  status            String    @default("PENDING") @db.VarChar(32)
  settledAt         DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cod_reconciliations")
}

model FinanceTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  shipmentId  String?  @map("shipment_id") @db.Uuid
  type        String   @db.VarChar(32)
  amount      Decimal  @db.Decimal(14, 2)
  description String?  @db.Text
  status      String   @default("CONFIRMED") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_finance_order_id")
  @@index([type], map: "idx_finance_type")
  @@map("finance_transactions")
}

model EInvoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  buyerName     String   @map("buyer_name") @db.VarChar(255)
  buyerTaxCode  String?  @map("buyer_tax_code") @db.VarChar(50)
  buyerAddress  String?  @map("buyer_address") @db.Text
  subtotal      Decimal  @db.Decimal(12, 2)
  vatRate       Decimal  @default(10) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount     Decimal  @map("vat_amount") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  status        String   @default("ISSUED") @db.VarChar(32)
  cqtCode       String?  @map("cqt_code") @db.VarChar(100)
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_e_invoices_order_id")
  @@map("e_invoices")
}

model Customer {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?                  @unique @map("user_id") @db.Uuid
  fullName      String                   @map("full_name") @db.VarChar(255)
  email         String                   @unique @db.VarChar(255)
  phone         String?                  @db.VarChar(50)
  address       String?                  @db.Text
  tier          String                   @default("STANDARD") @db.VarChar(32)
  totalSpent    Decimal                  @default(0) @map("total_spent") @db.Decimal(14, 2)
  totalOrders   Int                      @default(0) @map("total_orders")
  loyaltyPoints Int                      @default(0) @map("loyalty_points")
  segment       String                   @default("NEW") @db.VarChar(50)
  tags          String[]                 @default([])
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  loyaltyLogs   CustomerLoyaltyHistory[]

  @@index([tier], map: "idx_customers_tier")
  @@index([segment], map: "idx_customers_segment")
  @@map("customers")
}

model CustomerLoyaltyHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  action       String   @db.VarChar(50)
  pointsChange Int      @map("points_change")
  balanceAfter Int      @map("balance_after")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "idx_loyalty_customer")
  @@map("customer_loyalty_history")
}

model Coupon {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @unique @db.VarChar(50)
  discountType  String    @map("discount_type") @db.VarChar(32)
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  minOrderValue Decimal   @default(0) @map("min_order_value") @db.Decimal(12, 2)
  maxDiscount   Decimal?  @map("max_discount") @db.Decimal(12, 2)
  usageLimit    Int       @default(1000) @map("usage_limit")
  usedCount     Int       @default(0) @map("used_count")
  startDate     DateTime  @default(now()) @map("start_date") @db.Timestamptz(6)
  endDate       DateTime? @map("end_date") @db.Timestamptz(6)
  status        String    @default("ACTIVE") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("coupons")
}

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  role         String    @db.VarChar(50)
  enforce2fa   Boolean   @default(true) @map("enforce_2fa")
  ipRestricted Boolean   @default(false) @map("ip_restricted")
  allowedIps   String[]  @default([]) @map("allowed_ips")
  status       String    @default("ACTIVE") @db.VarChar(32)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp  String?   @map("last_login_ip") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model AuditLog {
  id          String   @id @db.VarChar(64)
  actorId     String   @map("actor_id") @db.VarChar(64)
  actorName   String   @map("actor_name") @db.VarChar(255)
  actorEmail  String   @map("actor_email") @db.VarChar(255)
  role        String   @db.VarChar(50)
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  entityId    String   @map("entity_id") @db.VarChar(255)
  ip          String   @db.VarChar(50)
  severity    String   @default("INFO") @db.VarChar(32)
  isSensitive Boolean  @default(false) @map("is_sensitive")
  beforeValue String?  @map("before_value") @db.Text
  afterValue  String?  @map("after_value") @db.Text
  description String   @db.Text
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorEmail], map: "idx_audit_logs_actor")
  @@index([resource], map: "idx_audit_logs_resource")
  @@index([severity], map: "idx_audit_logs_severity")
  @@index([timestamp], map: "idx_audit_logs_timestamp")
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @default("Super Admin") @map("updated_by") @db.VarChar(255)

  @@map("system_settings")
}

model CmsPost {
  id          String   @id @db.VarChar(64)
  title       String   @db.VarChar(500)
  slug        String   @unique @db.VarChar(500)
  category    String   @db.VarChar(100)
  author      String   @db.VarChar(255)
  status      String   @default("PUBLISHED") @db.VarChar(32)
  views       Int      @default(0)
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  seoTitle    String?  @map("seo_title") @db.VarChar(500)
  seoDesc     String?  @map("seo_desc") @db.Text
  content     String?  @db.Text
  tags        String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("cms_posts")
}
